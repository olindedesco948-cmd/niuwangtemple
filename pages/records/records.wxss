/* ===== 页面头部 ===== */
.page-header {
  text-align: center;
  padding: 30rpx 0 40rpx;
}

.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #ffd700;
  margin-bottom: 12rpx;
}

.page-desc {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 16rpx;
}

.empty-sub {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.4);
}

/* ===== 记录列表 ===== */
.records-list {
  padding-bottom: 40rpx;
}

.record-item {
  position: relative;
  border-left: 4rpx solid #ffd700;
}

.record-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.record-date-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.record-date {
  font-size: 30rpx;
  font-weight: bold;
  color: #ffd700;
}

.record-period {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  background: rgba(255, 215, 0, 0.1);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.record-time {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
}

.record-blessing {
  font-size: 28rpx;
  color: #fff;
  line-height: 1.6;
  letter-spacing: 1rpx;
}
